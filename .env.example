# Copia este archivo como .env y completa tu API key.
# Proveedor del LLM: gemini | groq | openai | ollama
LLM_PROVEEDOR=gemini
LLM_API_KEY=pega_aqui_tu_api_key
# Modelo usado en la evaluación del informe (si no existe, se elige uno disponible automáticamente)
LLM_MODELO=gemini-3.5-flash-lite
# LLM_BASE_URL=
LLM_TEMPERATURA=0

# Ruta al ejecutable de SWI-Prolog si no está en el PATH (ej. en Windows):
# SWIPL=C:\Program Files\swipl\bin\swipl.exe
